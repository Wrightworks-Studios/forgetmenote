[Unit]
Description=Debounced Git backup for ForgetMeNote notebook %i
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/lib/forgetmenote-git-backup/watcher.py --config %h/.config/forgetmenote-git-backup/%i.json
Restart=on-failure
RestartSec=10
TimeoutStopSec=15
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
MemoryMax=512M
TasksMax=32
StandardOutput=journal
StandardError=journal
SyslogIdentifier=forgetmenote-backup-%i

[Install]
WantedBy=default.target
