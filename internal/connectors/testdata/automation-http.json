{
  "version": 1,
  "connections": [
    {
      "id": "application-health",
      "label": "application-health",
      "kind": "http",
      "endpoint": "https://api.example.test",
      "timeoutSeconds": 30,
      "maxBytes": 524288,
      "operations": [
        {
          "name": "probe",
          "method": "GET",
          "path": "/health/",
          "query": {
            "format": "json"
          },
          "readOnly": true,
          "response": "status"
        }
      ]
    },
    {
      "id": "log-evidence",
      "label": "log-evidence",
      "kind": "http",
      "endpoint": "https://api.example.test",
      "timeoutSeconds": 30,
      "maxBytes": 524288,
      "operations": [
        {
          "name": "lag-current",
          "method": "GET",
          "path": "/api/datasources/proxy/uid/REPLACE_WITH_LOKI_DATASOURCE_UID/loki/api/v1/query",
          "readOnly": true,
          "query": {
            "query": "synthetic",
            "time": "{time}"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "time": {
                "type": "string",
                "maxLength": 40
              }
            },
            "required": [
              "time"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "lag-baseline",
          "method": "GET",
          "path": "/api/datasources/proxy/uid/REPLACE_WITH_LOKI_DATASOURCE_UID/loki/api/v1/query",
          "readOnly": true,
          "query": {
            "query": "synthetic",
            "time": "{time}"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "time": {
                "type": "string",
                "maxLength": 40
              }
            },
            "required": [
              "time"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "lag-samples",
          "method": "GET",
          "path": "/api/datasources/proxy/uid/REPLACE_WITH_LOKI_DATASOURCE_UID/loki/api/v1/query_range",
          "readOnly": true,
          "query": {
            "query": "synthetic",
            "start": "{start}",
            "end": "{end}",
            "limit": "100",
            "direction": "backward"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "start": {
                "type": "string",
                "maxLength": 40
              },
              "end": {
                "type": "string",
                "maxLength": 40
              }
            },
            "required": [
              "start",
              "end"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "account-completion",
          "method": "GET",
          "path": "/api/datasources/proxy/uid/REPLACE_WITH_LOKI_DATASOURCE_UID/loki/api/v1/query_range",
          "readOnly": true,
          "query": {
            "query": "synthetic",
            "start": "{start}",
            "end": "{end}",
            "limit": "100",
            "direction": "backward"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "start": {
                "type": "string",
                "maxLength": 40
              },
              "end": {
                "type": "string",
                "maxLength": 40
              }
            },
            "required": [
              "start",
              "end"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "rollout-logs",
          "method": "GET",
          "path": "/api/datasources/proxy/uid/REPLACE_WITH_LOKI_DATASOURCE_UID/loki/api/v1/query_range",
          "readOnly": true,
          "query": {
            "query": "synthetic",
            "start": "{start}",
            "end": "{end}",
            "step": "60"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "start": {
                "type": "string",
                "maxLength": 40
              },
              "end": {
                "type": "string",
                "maxLength": 40
              }
            },
            "required": [
              "start",
              "end"
            ],
            "additionalProperties": false
          }
        }
      ],
      "secretEnv": "EXAMPLE_API_TOKEN"
    },
    {
      "id": "cluster",
      "label": "cluster",
      "kind": "http",
      "endpoint": "https://api.example.test",
      "timeoutSeconds": 30,
      "maxBytes": 524288,
      "operations": [
        {
          "name": "deployments",
          "method": "GET",
          "path": "/apis/apps/v1/namespaces/REPLACE_WITH_NAMESPACE/deployments",
          "readOnly": true,
          "query": {
            "limit": "100"
          }
        },
        {
          "name": "events",
          "method": "GET",
          "path": "/api/v1/namespaces/REPLACE_WITH_NAMESPACE/events",
          "readOnly": true,
          "query": {
            "limit": "500",
            "fieldSelector": "type=Warning"
          }
        }
      ]
    },
    {
      "id": "drive",
      "label": "drive",
      "kind": "http",
      "endpoint": "https://api.example.test",
      "timeoutSeconds": 120,
      "maxBytes": 33554432,
      "operations": [
        {
          "name": "list",
          "method": "GET",
          "path": "/drive/v3/files",
          "readOnly": true,
          "query": {
            "q": "'{folder}' in parents and trashed = false",
            "fields": "nextPageToken,incompleteSearch,files(id,name,mimeType,version,modifiedTime)",
            "pageSize": "100",
            "pageToken": "{pageToken}",
            "supportsAllDrives": "true",
            "includeItemsFromAllDrives": "true"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "folder": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,128}$"
              },
              "pageToken": {
                "type": "string",
                "maxLength": 4096
              }
            },
            "required": [
              "folder",
              "pageToken"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "download",
          "method": "GET",
          "path": "/drive/v3/files/{id}",
          "readOnly": true,
          "query": {
            "alt": "media",
            "supportsAllDrives": "true"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 128
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": false
          },
          "response": "file"
        },
        {
          "name": "export",
          "method": "GET",
          "path": "/drive/v3/files/{id}/export",
          "readOnly": true,
          "query": {
            "mimeType": "{mimeType}"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 128
              },
              "mimeType": {
                "type": "string",
                "enum": [
                  "text/markdown",
                  "text/csv",
                  "text/plain",
                  "image/png",
                  "application/vnd.google-apps.script+json"
                ]
              }
            },
            "required": [
              "id",
              "mimeType"
            ],
            "additionalProperties": false
          },
          "response": "file"
        }
      ],
      "oauthRefresh": {
        "tokenURL": "https://oauth2.googleapis.com/token",
        "clientID": "REPLACE_WITH_EXISTING_DRIVE_CLIENT_ID",
        "clientSecretEnv": "DRIVE_CLIENT_SECRET",
        "refreshTokenEnv": "DRIVE_REFRESH_TOKEN"
      }
    },
    {
      "id": "advisory-api",
      "label": "advisory-api",
      "kind": "http",
      "endpoint": "https://api.example.test",
      "timeoutSeconds": 30,
      "maxBytes": 524288,
      "operations": [
        {
          "name": "queue",
          "method": "GET",
          "path": "/reviews/queue/",
          "readOnly": true,
          "query": {
            "page": "{page}"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "page": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1
              }
            },
            "required": [
              "page"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "case",
          "method": "GET",
          "path": "/orgs/{org}/images/{image}/",
          "readOnly": true,
          "inputSchema": {
            "type": "object",
            "properties": {
              "org": {
                "type": "string",
                "maxLength": 128
              },
              "image": {
                "type": "string",
                "maxLength": 128
              }
            },
            "required": [
              "org",
              "image"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "submit",
          "method": "POST",
          "path": "/orgs/{org}/images/{image}/assessments/",
          "readOnly": false,
          "bodyArgument": "submission",
          "inputSchema": {
            "type": "object",
            "properties": {
              "org": {
                "type": "string",
                "maxLength": 128
              },
              "image": {
                "type": "string",
                "maxLength": 128
              },
              "submission": {
                "type": "object",
                "properties": {
                  "revision": {
                    "type": "string",
                    "maxLength": 8192
                  },
                  "submission_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f-]{36}$"
                  },
                  "extraction": {
                    "type": "object"
                  },
                  "assessment": {
                    "type": "object"
                  },
                  "review_details": {"type": "object"},
                  "evidence_urls": {
                    "type": "array",
                    "maxItems": 50,
                    "items": {
                      "type": "string",
                      "maxLength": 2000
                    }
                  }
                },
                "required": [
                  "revision",
                  "submission_id",
                  "extraction",
                  "assessment",
                  "evidence_urls"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "org",
              "image",
              "submission"
            ],
            "additionalProperties": false
          }
        }
      ],
      "externalProcessing": true,
      "secretEnv": "EXAMPLE_API_TOKEN",
      "authScheme": "Bearer"
    }
  ]
}
