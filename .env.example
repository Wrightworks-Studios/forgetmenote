PUBLIC_URL=http://localhost:8080
PORT=8080
PUID=1000
PGID=1000
HEADLESS=false

# Preferred private, sectioned operator configuration. When set, remove legacy
# integration variables below; see docs/instance-configuration.md.
INSTANCE_CONFIG_FILE=

# Authelia trusted-header SSO. See docs/deployment.md before enabling.
ADMIN_USERS=
PROXY_SECRET_FILE=
TRUSTED_PROXY_CIDRS=

# The instance database: a private file holding its connection URL. The
# compose file mounts ./secrets/database-url here; see docs/postgres.md.
DATABASE_URL_FILE=/run/secrets/database-url

# Where files kept outside the database live: source job originals, repository
# source indexes and export bundles. Empty keeps them in the data directory;
# gateways sharing an instance name an S3 bucket in this JSON file instead.
BLOBS_CONFIG_FILE=

# Hide these comma-separated path prefixes from lists/search, not direct reads or backups.
BROWSE_EXCLUDE_PREFIXES=

# Set to paused on a restored copy beside the live instance: no Slack, email,
# automations, background AI, backup leases or personal token refreshes until an
# operator removes it. See docs/postgres.md#outgoing-paused.
OUTGOING=

# Optional identity-only GitHub OAuth app. See docs/github-attribution.md.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET_FILE=

# Separate read-only repository GitHub App; see docs/repository-notebooks.md.
REPOSITORY_APP_CONFIG_FILE=
BACKUP_APP_CONFIG_FILE=
OWNER_MAP_FILE=
# AI provider configuration for notebook chat and optional automated recipes/digests.
CHAT_CONFIG_FILE=
# Per-user Google/Slack OAuth app configuration and encrypted credential vault.
# See docs/personal-assistant.md; identity-provider login is a separate grant.
PERSONAL_CONNECTIONS_CONFIG_FILE=
# Optional standalone typed decisions (currently TypeSafe/Jev); no chat provider required. See docs/jev.md.
DECISION_CONFIG_FILE=

# Optional connections, scheduled work, external MCP and Slack. Mount files outside
# notebooks; see deploy/integrations/README.md. Values are paths inside the container.
DATA_CONNECTIONS_CONFIG_FILE=
AUTOMATIONS_CONFIG_FILE=
AUTOMATION_PYTHON=
SLACK_CONFIG_FILE=

# Optional OIDC login; mount the secret file using Compose. GitHub linking is separate.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET_FILE=
OIDC_DEFAULT_GROUPS=
# true adds the email scope (Google needs it to send the verified address).
OIDC_REQUEST_EMAIL=

# Local username/password login is the default. Create the first personal account
# using Recovery administrator, then complete Create your administrator account.
# Configuring OIDC or a trusted proxy disables local password sign-in, even if
# the provider is unavailable. GitHub authorship linking is unrelated.

# Optional OpenAI /v1/embeddings or Ollama /api/embed endpoint. See docs/knowledge.md.
# For OpenAI: https://api.openai.com/v1/embeddings and a mounted API key file.
EMBEDDING_URL=
EMBEDDING_SECRET_FILE=
